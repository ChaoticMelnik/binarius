{
  "name": "binarius",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "check": "tsc -b --clean && vitest run && tsc -b && eslint .",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "pnpm --filter @binarius/db run db:generate",
    "db:migrate": "pnpm --filter @binarius/db run db:migrate",
    "db:check": "pnpm --filter @binarius/db run db:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
