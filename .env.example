# Copy to .env (gitignored) AND fill in the eight values marked REQUIRED below: compose refuses
# to start while any of them is empty, so copying this file is a starting point, not a working
# configuration. Six of the eight are secrets; TOKEN_ENCRYPTION_KEY_ID and BROKER_PARTNER_REF
# are plain identifiers, required because the key needs its id and because a made-up partner
# code loses the partner attribution of every new account without an error.
#
# "Refuses to start" covers a partial start too: Compose interpolates this whole file before it
# picks which services to run, so `docker compose up -d postgres redis` — the command the tests
# need — also stops until all eight are set. TELEGRAM_BOT_TOKEN is one of the eight, read by
# `bot` and `backend` only, so working on the database alone still needs a value there.
#
# The optional Postgres, Redis and Backend values below match the compose.yaml defaults. The eight
# REQUIRED ones have no default to match. Of the commented OAuth variables further down, the
# authorize URL and the API base match the compose defaults byte for byte; the redirect URI does
# not. DATABASE_URL, TEST_DATABASE_URL and REDIS_URL at the bottom are for host-side tools and
# point at localhost, where compose uses the service names.
#
# The apps run in Docker and take their environment from compose.yaml; .env is read by Compose
# for interpolation. Host-side tools read the process environment only: drizzle-kit reads
# DATABASE_URL, the integration tests read TEST_DATABASE_URL (a native Postgres 18 on the host,
# never the compose one) and REDIS_URL — README → Database and → Test database have the commands.

# --- Postgres (compose service `postgres`) ---
# Credentials are interpolated into a URL without encoding: use [A-Za-z0-9_-] only.
POSTGRES_USER=binarius
POSTGRES_PASSWORD=binarius
POSTGRES_DB=binarius
# Host port bound on 127.0.0.1
POSTGRES_PORT=5432

# --- Redis (compose service `redis`) ---
# Host port bound on 127.0.0.1
REDIS_PORT=6379

# --- Backend (compose service `backend`) ---
# Host port bound on 127.0.0.1; the container always listens on 3000
BACKEND_PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Budget for each dependency check in GET /health: 500-2500; the compose probe timeout (3s) is sized above the ceiling
HEALTH_TIMEOUT_MS=2000
# How often the backend refreshes the broker's pairs catalog (GET /trading/pairs): 30000-60000,
# default 30000. Forwarded only when set (docs/pairs-catalog.md).
# BROKER_PAIRS_TTL_MS=30000
# How often the backend refreshes the broker balance of the accounts in work: 10000-60000,
# default 60000, and how many such GETs it makes per minute at most: 1-500, default 200.
# Forwarded only when set (docs/broker-balance.md).
# BALANCE_RECONCILE_INTERVAL_MS=60000
# BALANCE_POLL_MAX_PER_MINUTE=200
# REQUIRED. Shared secret the bot and the trading worker present to the backend's internal API
# (Authorization: Bearer ...), 16+ chars, no whitespace; delivered to `backend`, `bot` and
# `trading-worker`, which parse it by the same rules. Generate one: `openssl rand -hex 32`. Left empty on purpose — a value here would be
# a published secret that a deployment inherits by copying this file, which is exactly what the
# required-variable form exists to prevent.
INTERNAL_API_TOKEN=

# --- Trading worker (compose service `trading-worker`) ---
# BACKEND_URL is fixed by compose (http://backend:3000); BROKER_API_BASE_URL is the same value the
# backend reads (below). Optional; commented values are the code defaults
# (docs/trade-intent-transport.md → Configuration)
# INTENT_MAX_AGE_MS=60000
# SUBMIT_ACK_TIMEOUT_MS=10000
# WORKER_CONCURRENCY=5

# --- Secrets and the values that must be set ---
# BROKER_WS_URL and WELCOME_VIDEO_FILE_ID reach the containers only when set here;
# BROKER_CLIENT_ID has a compose default, so the container always gets one. The eight marked
# REQUIRED are different: compose stops at interpolation while one of them is empty, so nothing
# starts until you fill them in.
# REQUIRED. The bot token from @BotFather, no whitespace. Delivered to `bot`, which polls it, and
# to `backend`, which only sends the message after an OAuth login on it (#128); the whole file is
# interpolated first, so every compose command needs it (see the header).
TELEGRAM_BOT_TOKEN=
# Optional, `bot` only. file_id of a video the bot sends with the welcome message; without it the
# welcome is plain text. No whitespace: a trailing newline here is a file id Telegram refuses on
# every /start. A file id Telegram refuses costs the video, not the welcome.
# WELCOME_VIDEO_FILE_ID=
# Binodex Broker: names fixed by issue #3, full contract verified in #8/#9. BROKER_WS_URL and
# BROKER_API_BASE_URL are delivered to `backend` and `trading-worker` (the worker reads trade
# lists from the API since #90); BROKER_CLIENT_ID and BROKER_CLIENT_SECRET go to `backend` only,
# because the worker never exchanges a grant.
# BROKER_CLIENT_ID=
# REQUIRED. The OAuth client secret from the broker's cabinet (#8). Empty here for the same
# reason as the tokens above.
BROKER_CLIENT_SECRET=
# The broker Socket.IO server. Set, the worker keeps a broker session per account in work and
# sends orders over it (docs/broker-session.md); unset, every order goes over REST. Keep it unset
# until the two-socket probe (#285; docs/broker-socket.md -> Observed live) has printed its safe
# verdict on the pilot.
# BROKER_WS_URL=https://broker-ws.binodex.app
# The Binodex trading grant (#134), read by `backend` and `trading-worker`. Default false: real
# intents are refused (backend, 409 real_trading_disabled) and rejected (worker). Exactly true
# or false; any other value, empty included, stops both processes. Set it to true only once the
# grant is confirmed; a change means editing .env and restarting both services.
# REAL_TRADING_ENABLED=false
# REQUIRED. AES-256-GCM key for broker tokens at rest (packages/db createTokenCipher): 32 random
# bytes, base64 — `openssl rand -base64 32`. For local work you may paste the all-zero key
# AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= together with TOKEN_ENCRYPTION_KEY_ID=dev, which
# is the only pair the backend accepts it in. Pasting it is a deliberate act; shipping it as a
# default was not.
TOKEN_ENCRYPTION_KEY=
# REQUIRED. Names the key above so a rotation can tell ciphertexts apart; must not contain '|'
# or whitespace. Use `dev` only with the all-zero key.
TOKEN_ENCRYPTION_KEY_ID=

# --- Binodex OAuth login (#9, #114) ---
# The authorize page the login opens, and the API host the code exchange and the token refresh
# post to; https only. The API lives on api.binodex.app: binodex.app itself answers every API call
# with 405. The authorize URL is read by `backend` and `web`: the web's Mini App login page
# navigates only to it. The API host is read by `backend` and `trading-worker`.
# BROKER_OAUTH_AUTHORIZE_URL=https://binodex.app/oauth/authorize
# BROKER_API_BASE_URL=https://api.binodex.app
# Where the broker delivers the code: the callback page `web` serves. Defaults to
# <WEB_PUBLIC_URL>/oauth/callback, and a login completes only when it equals that value of the
# same deployment (host and port spelling aside: case, a default or zero-padded port, IPv4
# shorthand, IDNA mapping). Set it only to match the spelling registered with the OAuth client,
# which the backend sends byte for byte (localhost is not 127.0.0.1) - never to point elsewhere.
# Spelled exactly scheme://host[:port]/oauth/callback: no whitespace, control or invisible format
# characters (a CRLF file leaves a \r), query, fragment, `\`, `%`, `@` or dot-segments - the
# backend refuses to start otherwise. http is allowed only for 127.0.0.1 or localhost; with http
# the bot sends a plain link instead of the Mini App, because Telegram opens only https Mini Apps.
# BROKER_OAUTH_REDIRECT_URI=https://your-host/oauth/callback
# REQUIRED. The short partner code from the partner link (https://bdclick.app/smart/<code> ->
# <code>): [A-Za-z0-9_-], 1-64 chars. The link itself is refused at backend startup. Attached to
# every authorization request as `ref`, so a new user is registered under this installation's
# partner account; #162 sends it as `partner_code`.
BROKER_PARTNER_REF=

# --- Staff login to the admin pages (#68) ---
# REQUIRED. The token of a SECOND bot from @BotFather, not TELEGRAM_BOT_TOKEN: the staff bot
# polls from inside `backend`, and two pollers on one token fight over getUpdates (409). The
# backend refuses to start when it equals TELEGRAM_BOT_TOKEN. No whitespace. A staff member
# learns the Telegram ID their account needs by sending /start to it.
ADMIN_BOT_TOKEN=
# REQUIRED. Shared secret `web` presents to the backend's /admin/* routes, 16+ chars, no
# whitespace. Narrower than INTERNAL_API_TOKEN: it opens /admin/* and nothing else, and every
# read behind it also needs a staff session. The backend refuses to start when it equals
# INTERNAL_API_TOKEN — one value in both would open the whole internal API to `web`.
# `openssl rand -hex 32`.
ADMIN_WEB_TOKEN=
# Optional. The origin `web` serves its pages from - the admin pages and the Mini App login
# pages (#114). Used to check the Origin header on every POST, to decide whether the session
# cookie may be Secure, and as the default origin of BROKER_OAUTH_REDIRECT_URI. https, or http
# only for 127.0.0.1 / localhost; spelled exactly scheme://host[:port] - no whitespace, control
# or invisible format characters, `/`, `?`, `#`, `\`, `%`, `@` or dot-segments (compose appends
# /oauth/callback to it). Change it together with WEB_PORT below - the two defaults are tied by
# a test, because a mismatch 403s every form. Called ADMIN_PUBLIC_URL before #114 - compose
# refuses to start while the old name is still set.
# WEB_PUBLIC_URL=http://127.0.0.1:3001
# Host port for the `web` pages, bound on 127.0.0.1; the container always listens on 3000
WEB_PORT=3001

# --- Host-side tools (drizzle-kit, the integration tests) ---
# Containers never see these; they build their own URLs from the values above.
# If another Postgres already owns host port 5432, set POSTGRES_PORT above and here.
DATABASE_URL=postgres://binarius:binarius@localhost:5432/binarius
# The integration tests' database: a native PostgreSQL 18 on the host (README → Test database)
TEST_DATABASE_URL=postgres://binarius@127.0.0.1:5434/binarius
REDIS_URL=redis://localhost:6379
