# Copy to .env (gitignored) AND fill in the four values marked REQUIRED below: compose refuses
# to start while any of them is empty, so copying this file is a starting point, not a working
# configuration. Three of the four are secrets; TOKEN_ENCRYPTION_KEY_ID is a plain identifier
# that is required because the key is.
#
# The optional Postgres, Redis and Backend values below match the compose.yaml defaults. The four
# REQUIRED ones have no default to match. Of the commented OAuth variables further down, the
# authorize URL and the API base match the compose defaults byte for byte; the redirect URI and
# the partner ref do not. DATABASE_URL and REDIS_URL at the bottom are for host-side tools
# and point at localhost, where compose uses the service names.
#
# The apps run in Docker and take their environment from compose.yaml; .env is read by Compose
# for interpolation. Host-side tools (drizzle-kit, the packages/db tests) read DATABASE_URL from
# the process environment only — README's "Running the tests" block has the commands that work.

# --- Postgres (compose service `postgres`) ---
# Credentials are interpolated into a URL without encoding: use [A-Za-z0-9_-] only.
POSTGRES_USER=binarius
POSTGRES_PASSWORD=binarius
POSTGRES_DB=binarius
# Host port bound on 127.0.0.1
POSTGRES_PORT=5432

# --- Redis (compose service `redis`) ---
# Host port bound on 127.0.0.1
REDIS_PORT=6379

# --- Backend (compose service `backend`) ---
# Host port bound on 127.0.0.1; the container always listens on 3000
BACKEND_PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Budget for each dependency check in GET /health: 500-2500; the compose probe timeout (3s) is sized above the ceiling
HEALTH_TIMEOUT_MS=2000
# REQUIRED. Shared secret the bot presents to the backend's internal API (Authorization:
# Bearer ...), 16+ chars, no whitespace. Generate one: `openssl rand -hex 32`. Left empty on
# purpose — a value here would be a published secret that a deployment inherits by copying
# this file, which is exactly what the required-variable form exists to prevent.
INTERNAL_API_TOKEN=

# --- Trading worker (compose service `trading-worker`) ---
# Optional; commented values are the code defaults (docs/trade-intent-transport.md → Configuration)
# INTENT_MAX_AGE_MS=60000
# SUBMIT_ACK_TIMEOUT_MS=10000
# WORKER_CONCURRENCY=5

# --- Secrets and the values that must be set ---
# TELEGRAM_BOT_TOKEN and BROKER_WS_URL reach the containers only when set here; BROKER_CLIENT_ID
# has a compose default, so the container always gets one. The four marked REQUIRED are
# different: compose stops at interpolation while one of them is empty, so the stack does not
# start until you fill them in.
# Delivered to `bot` only
# TELEGRAM_BOT_TOKEN=
# Binodex Broker: names fixed by issue #3, full contract verified in #8/#9. BROKER_WS_URL is
# delivered to `backend` and `trading-worker`, though no code reads it yet; BROKER_CLIENT_ID and
# BROKER_CLIENT_SECRET go to `backend` only, because the worker never exchanges a grant.
# BROKER_CLIENT_ID=
# REQUIRED. The OAuth client secret from the broker's cabinet (#8). Empty here for the same
# reason as the token above.
BROKER_CLIENT_SECRET=
# BROKER_WS_URL=
# REQUIRED. AES-256-GCM key for broker tokens at rest (packages/db createTokenCipher): 32 random
# bytes, base64 — `openssl rand -base64 32`. For local work you may paste the all-zero key
# AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= together with TOKEN_ENCRYPTION_KEY_ID=dev, which
# is the only pair the backend accepts it in. Pasting it is a deliberate act; shipping it as a
# default was not.
TOKEN_ENCRYPTION_KEY=
# REQUIRED. Names the key above so a rotation can tell ciphertexts apart; must not contain '|'
# or whitespace. Use `dev` only with the all-zero key.
TOKEN_ENCRYPTION_KEY_ID=

# --- Binodex OAuth login (#9, backend only) ---
# The authorize page the bot links to, and the API base the token exchange posts to; https only
# BROKER_OAUTH_AUTHORIZE_URL=https://binodex.app/oauth/authorize
# BROKER_API_BASE_URL=https://binodex.app
# Where the broker delivers the code; must match the value registered with the OAuth client.
# http is allowed only for 127.0.0.1 or localhost, which is what compose uses in development.
# BROKER_OAUTH_REDIRECT_URI=https://your-host/oauth/callback
# Partner reference attached to every authorization request, so a new user is registered under
# this installation's partner account
# BROKER_PARTNER_REF=

# --- Host-side tools (drizzle-kit, the integration tests) ---
# Containers never see these; they build their own URLs from the values above.
# If another Postgres already owns host port 5432, set POSTGRES_PORT above and here.
DATABASE_URL=postgres://binarius:binarius@localhost:5432/binarius
REDIS_URL=redis://localhost:6379
