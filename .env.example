# Copy to .env (gitignored). Every value below is also the compose.yaml default,
# so `docker compose up` works without this file. The apps run in Docker and get
# their environment from compose.yaml; .env is read by Compose for interpolation
# and by tools that load it themselves (e.g. drizzle-kit, issue #7).

# --- Postgres (compose service `postgres`) ---
# Credentials are interpolated into a URL without encoding: use [A-Za-z0-9_-] only.
POSTGRES_USER=binarius
POSTGRES_PASSWORD=binarius
POSTGRES_DB=binarius
# Host port bound on 127.0.0.1
POSTGRES_PORT=5432

# --- Redis (compose service `redis`) ---
# Host port bound on 127.0.0.1
REDIS_PORT=6379

# --- Backend (compose service `backend`) ---
# Host port bound on 127.0.0.1; the container always listens on 3000
BACKEND_PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Budget for each dependency check in GET /health (min 500); the compose probe timeout (3s) must exceed it
HEALTH_TIMEOUT_MS=2000

# --- Secrets (passed to the containers only when set; a bare `NAME=` would pass an empty string) ---
# TELEGRAM_BOT_TOKEN=
# Binodex Broker: names fixed by issue #3, full contract verified in #8/#9
# BROKER_CLIENT_ID=
# BROKER_CLIENT_SECRET=
# BROKER_WS_URL=

# --- Tools that load .env themselves (drizzle-kit, #7) ---
# Containers never see these; they build their own URLs from the values above.
DATABASE_URL=postgres://binarius:binarius@localhost:5432/binarius
REDIS_URL=redis://localhost:6379
